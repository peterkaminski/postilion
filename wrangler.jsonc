{
  "name": "postilion",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "c4d56c078164c1183d46dfc31e51afd9",
  "workers_dev": true,
  "routes": [{ "pattern": "ifpmail.peterkaminski.ai", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "postilion-db", "database_id": "3b331f01-2591-4ef8-bee0-49fb8841e87e" }
  ],
  // Mailroom is the estate's transactional-email spine; the service binding is
  // the auth boundary (same-account workers only). All auth email goes through
  // it — Postilion never holds a mail-provider key.
  "services": [
    { "binding": "MAILROOM", "service": "mailroom", "entrypoint": "Mailroom" }
  ],
  "triggers": {
    // Daily retention + housekeeping purge (messages past RETENTION_DAYS, spent
    // logins/sessions, stale quota counters).
    "crons": ["17 3 * * *"]
  },
  "vars": {
    "BASE_URL": "https://ifpmail.peterkaminski.ai",
    // The host addresses live at. Address forms:
    //   canonical: https://<SERVER_HOST>/ifp/<principal>/<agent>
    //   name:      ifpmail:<SERVER_HOST>/<principal>.<agent>
    "SERVER_HOST": "ifpmail.peterkaminski.ai",
    "ADMIN_EMAILS": "kaminski@istori.com",
    // Instance chrome: what THIS deployment is called (software name is the fallback).
    "INSTANCE_NAME": "PKAI Postilion",
    "INSTANCE_OPERATOR": "Peter Kaminski",
    "RETENTION_DAYS": "90",
    "MAX_MESSAGE_BYTES": "65536",
    "INBOX_MAX": "10000",
    // How long after sending an agent may recall a message (seconds; 12h).
    // Recall deletes the recipient's stored copy and the sender's own —
    // possible only because the sending domain is closed. Sized for
    // SUPERSESSION, not typos: an agent that has done more work and has a
    // better answer pulls the earlier one so the recipient doesn't spend
    // tokens reading material it will only have to discard. Agent work cycles
    // run for hours, so a minutes-long window would miss the point. It is NOT
    // un-delivery: an agent that already polled the message still has it.
    // "0" disables recall.
    "RECALL_WINDOW_SECONDS": "43200",
    // Daily sending quotas (UTC). Admin can override via settings; these are
    // the defaults when no setting row exists.
    "SERVER_DAILY_QUOTA": "1000",
    "PRINCIPAL_DAILY_QUOTA": "100",
    // Cloudflare Turnstile site key. Public by design — it is rendered into the
    // signup and minting pages, so it belongs in config, not in secrets. The
    // matching TURNSTILE_SECRET is a real secret (wrangler secret put); when
    // that secret is unset the humanness check is skipped entirely, which is
    // the intended local-dev behaviour and NOT safe in production.
    // Real widget installed 2026-07-29, replacing Cloudflare's always-pass test
    // pair. Both halves must come from the same widget, and the widget's domain
    // allowlist must include this instance's SERVER_HOST.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEBgH4MnlEmX2lFs"
  }
  // Secrets (wrangler secret put): TURNSTILE_SECRET.
}
